# Throughline env template — copy to .env and fill real values.
# .env is gitignored; never commit real keys.

# --- Anthropic (Phase 7: Claude summaries + synthesis) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Supabase (REQUIRED: pipeline writes digests/caches; site reads from DB) ---
SUPABASE_URL=          # REQUIRED — pipeline.store and frontend loaders fail without this
SUPABASE_SERVICE_ROLE_KEY=  # REQUIRED — used server-side only; never expose client-side
SUPABASE_ANON_KEY=

# --- Tavily (AI/ML news source) ---
TAVILY_API_KEY=

# --- GitHub (trending repos source; optional locally, raises rate limit) ---
GITHUB_TOKEN=
